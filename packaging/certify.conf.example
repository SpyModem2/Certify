CERTIFY_DATA_DIR=/var/lib/certify
CERTIFY_SECRET=replace-with-at-least-32-random-characters
CERTIFY_SESSION_MINUTES=30
# Optional: leer lassen, um keinen regelmäßigen Passwortwechsel zu erzwingen.
CERTIFY_PASSWORD_MAX_AGE_DAYS=
CERTIFY_TRUSTED_HOSTS=certify.example.internal
CERTIFY_DEBUG=false
CERTIFY_SMTP_HOST=localhost
CERTIFY_SMTP_PORT=25
CERTIFY_MAIL_FROM=certify@localhost

# Nur waehrend der Installation ausgewertet: self-signed, custom oder letsencrypt.
CERTIFY_TLS_MODE=self-signed
CERTIFY_TLS_HOSTNAME=certify.example.internal
