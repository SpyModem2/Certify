[Unit]
Description=Certify certificate lifecycle manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=certify
Group=certify
EnvironmentFile=/etc/certify/certify.conf
ExecStart=/opt/certify/venv/bin/certify serve --host 0.0.0.0 --port 443 --ssl-certfile /etc/certify/tls/fullchain.pem --ssl-keyfile /etc/certify/tls/privkey.pem
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/certify
ReadOnlyPaths=/etc/certify/tls
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
